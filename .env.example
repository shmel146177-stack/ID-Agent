# Настройки AI-провайдера ID-Agent.
# Переменные ID_AGENT_AI_* имеют приоритет; OPENAI_API_KEY и OPENAI_MODEL
# продолжают работать как запасные.

# Провайдер: openai | deepseek | local-qwen | свой идентификатор
ID_AGENT_AI_PROVIDER=openai

# Протокол: responses | chat_completions.
# Пустое значение — протокол профиля провайдера.
ID_AGENT_AI_PROTOCOL=

# Адрес эндпоинта. Пустое значение — адрес профиля.
ID_AGENT_AI_BASE_URL=

# Ключ провайдера. Локальному серверу ключ не нужен.
ID_AGENT_AI_API_KEY=

# Модель. OPENAI_MODEL используется, когда эта переменная пуста.
ID_AGENT_AI_MODEL=

# Обращения к модели. По умолчанию выключены.
ID_AGENT_AI_ENABLED=false

# Примеры
#
# OpenAI (Responses API):
#   ID_AGENT_AI_PROVIDER=openai
#   ID_AGENT_AI_API_KEY=sk-...
#   ID_AGENT_AI_MODEL=gpt-5.6-luna
#
# DeepSeek (Chat Completions, адрес и модель подставляются профилем):
#   ID_AGENT_AI_PROVIDER=deepseek
#   ID_AGENT_AI_API_KEY=sk-...
#
# Локальная Qwen через LM Studio (ключ не требуется):
#   ID_AGENT_AI_PROVIDER=local-qwen
#   ID_AGENT_AI_ENABLED=true
#
# Собственный эндпоинт:
#   ID_AGENT_AI_PROVIDER=custom
#   ID_AGENT_AI_BASE_URL=https://gateway.example/v1
#   ID_AGENT_AI_MODEL=my-model
#   ID_AGENT_AI_API_KEY=...
